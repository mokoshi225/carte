#!/bin/bash
# serve-wt: ワークツリーの bp-app.html を HTTPサーバーで提供
# Usage:
#   ./serve-wt                   → ワークツリー一覧を表示
#   ./serve-wt main 8081         → main をポート8081でサーブ
#   ./serve-wt feature/reservation-system 8082  → reservation-systemをポート8082でサーブ

REPO="/home/mokoshi/carte"

if [ $# -eq 0 ]; then
    echo "=== ワークツリー一覧 ==="
    git -C "$REPO" worktree list --porcelain | grep "^worktree\|^branch\|^HEAD" | paste - - -
    echo ""
    echo "使い方: $0 <ブランチ名> <ポート番号>"
    echo "例: $0 main 8081"
    exit 0
fi

BRANCH="$1"
PORT="${2:-8081}"

# ブランチ名からワークツリーのパスを取得
WT_PATH=$(git -C "$REPO" worktree list --porcelain | grep -A1 "branch refs/heads/$BRANCH$" | grep "^worktree " | cut -d' ' -f2-)

if [ -z "$WT_PATH" ]; then
    # branch refs/heads/... 形式でマッチしなかった場合、HEAD のコミットハッシュで探す
    echo "エラー: ブランチ '$BRANCH' のワークツリーが見つかりません"
    echo "利用可能なブランチ:"
    git -C "$REPO" worktree list | awk '{print $3}' | tr -d '[]'
    exit 1
fi

echo "サーブ中: $WT_PATH (branch: $BRANCH) → http://localhost:$PORT"
cd "$WT_PATH" && python3 -m http.server "$PORT"
